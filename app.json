{
  "expo": {
    "name": "Reciro",
    "slug": "reciro",
    "version": "1.0.0",
    "description": "Reciro - Smart Receipt Scanner. Scan. Save. Simplify.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.dcanpolat.reciro",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Reciro needs camera access so you can scan receipt photos.",
        "NSPhotoLibraryUsageDescription": "Reciro needs photo library access so you can choose receipt photos."
      }
    },
    "android": {
      "package": "com.dcanpolat.reciro",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E0F6E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Reciro needs camera access so you can scan receipt photos.",
          "photosPermission": "Reciro needs photo library access so you can choose receipt photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Reciro needs camera access so you can scan receipt photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8547815405822008~3094032770",
          "iosAppId": "ca-app-pub-8547815405822008~5448733377"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3bd780d9-eec7-443e-990e-a60a3a3e20ee"
      }
    },
    "owner": "denizcanpolat2307"
  }
}
