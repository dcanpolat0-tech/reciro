OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
RECEIPT_ANALYSIS_PORT=8787
PORT=8787

# Legacy compatibility only. A value shipped with EXPO_PUBLIC_* is not a secret
# and must never be treated as an authorization mechanism.
# ANALYSIS_CLIENT_TOKEN=

# Optional rate limit for the public analysis endpoint.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Use your Windows local network IP here when testing on a real phone.
# Example: EXPO_PUBLIC_RECEIPT_ANALYSIS_URL=http://192.168.1.125:8787/analyze-receipt
EXPO_PUBLIC_RECEIPT_ANALYSIS_URL=http://YOUR_COMPUTER_IP:8787/analyze-receipt

# Supabase public project configuration. These values are safe for the mobile app;
# never add a Supabase service_role or secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Render-only configuration for verified Supabase sessions. Keep enforcement
# false until the Supabase-enabled mobile build is live and tested.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
SUPABASE_AUTH_REQUIRED=false

# RevenueCat public iOS SDK key for App Store/TestFlight builds.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_ios_sdk_key
